import ../sequence.mcbt
import ../score.mcbt
import ../chatter.mcbt

function summon {
	data modify storage spiced:mantis_npc conversation_order set value []
	data modify storage spiced:mantis_npc conversations set value [1,2,3]

	set #spiced.mantis_npc.chatting spiced.dummy 0
	set #spiced.mantis_npc.mining_timer spiced.dummy 0

	summon mannequin 227 73.9 183 {Rotation:[90f, 0f], Tags:['summit.booth_entity.spiced', 'spiced.mantis_npc'],Invulnerable:1b,immovable:true,profile:{name:'stateus'},hide_description:true,active_effects:[{id:invisibility,show_particles:false,duration:-1}],equipment:{head:{id:"minecraft:barrier",count:1,components:{"minecraft:item_model":"thorax:entity/bug/praying_mantis"}}}}

	summon interaction 227 75 183 { \
		Tags:['summit.booth_entity.spiced', 'summit.static', 'spiced.mantis_npc.interaction', 'summit.interactable'], \
		width:1f, height:1f, response:true, \
		data: { \
			summit_interactable: { \
				on_right_click: 'function spiced:mantis_npc/start_conversation', \
				on_left_click: 'function spiced:mantis_npc/start_conversation', \
			} \
		} \
	}
	function ./reset
}

function tick {
	execute \
		if score #spiced.mantis_npc.chatting spiced.dummy matches 1 \
		as @e[type=mannequin,tag=spiced.mantis_npc,limit=1] \
		at @s \
	run return run rotate @s facing entity @p
}

function says {
	# ARGS: {message: TextComponent}
	$execute \
		as @e[type=mannequin,tag=spiced.mantis_npc,limit=1] \
		at @s \
		positioned ~ ~2.125 ~ \
	run { {message: $(message)}
		chatter b57a3c1f-68da-441b-9361-f092d6630b55 4..8 spiced:mantis_npc/sounds
	}
}

function sounds {
	execute store result storage spiced:mantis_npc args.note float 0.01 run random value 100..150
	{ with storage spiced:mantis_npc args
		$playsound spiced:booth.sr_mantis.speech player @a[distance=..20] ~ ~ ~ 0.5 $(note)
	}
}

function reset {
	execute as @e[type=mannequin,tag=spiced.mantis_npc,limit=1] at @s run rotate @s 90 0
	scoreboard players set #spiced.mantis_npc.chatting spiced.dummy 0
	kill b57a3c1f-68da-441b-9361-f092d6630b55

	REPEAT (0, 110) as i {
		schedule clear spiced:mantis_npc/zzz/<%i%>
	}
}

function start_conversation {
	execute if score #spiced.mantis_npc.chatting spiced.dummy matches 1 run return 0

	execute store result score #length spiced.dummy run data get storage spiced:mantis_npc conversation_order
	execute if score #length spiced.dummy matches 0 run {
		function shuffle:shuffle {source: 'storage spiced:mantis_npc conversations', target: 'storage spiced:mantis_npc conversation_order'}
	}

	set #spiced.mantis_npc.chatting spiced.dummy 1

	data modify storage spiced:temp args.conversation set from storage spiced:mantis_npc conversation_order[0]
	data remove storage spiced:mantis_npc conversation_order[0]
	{ with storage spiced:temp args
		$function spiced:mantis_npc/conversation$(conversation)
	}
}

function conversation1 {
	sequence {
		function ./says {message:[{text:'Have', color: '#f0d8c8'}, ' you', ' seen', ' my', ' son?']}

		sleep 60t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' I', ' also', ' am', ' a', ' robot.']}

		sleep 80t
		function ./says {message:[{text:'I\'m', color: '#f0d8c8'}, ' C4T', ' the', ' Computer', ' Controlled', ' Cat-like', ' Creature', ' Technology!']}

		sleep 80t
		function ./says {message:[{text:'Genius', color: '#f0d8c8'}, ' acronym', ' right?']}

		sleep 40t
		function ./says {message:[{text:'My', color: '#f0d8c8'}, ' creators', ' thought', ' so.']}

		sleep 40t
		function ./reset
	}
}

function conversation2 {
	sequence {
		function ./says {message:[{text:'I', color: '#f0d8c8'}, ' am', ' planned', ' for', ' Spiced.']}

		sleep 80t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' not', ' 1.0']}

		sleep 40t
		function ./says {message:[{text:'Stateus', color: '#f0d8c8'}, ' and', ' Pan', ' have', ' way', ' too', ' much', ' to', ' do.']}

		sleep 80t
		function ./says {message:[{text:'I', color: '#f0d8c8'}, ' hope', ' I', ' can', ' be', ' implemented', ' in', ' Spiced\'s', ' first', ' update', ' after', ' release.']}

		sleep 100t
		function ./says {message:[{text:'I', color: '#f0d8c8'}, ' know', ' there', ' isn\'t', ' space', ' for', ' me', ' in', ' release.']}

		sleep 80t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' I', ' know', ' I', ' will', ' see', ' you', ' soon!']}

		sleep 80t
		function ./reset
	}
}

function conversation3 {
	sequence {
		function ./says {message:[{text:'If', color: '#f0d8c8'}, ' only', ' I', ' could', ' move...']}

		sleep 80t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' I', ' lack', ' animations', ' at', ' the', ' moment.']}

		sleep 80t
		function ./says {message:[{text:'Someday...', color: '#f0d8c8'}]}

		sleep 30t
		function ./reset
	}
}