import ../sequence.mcbt
import ../score.mcbt
import ../chatter.mcbt

function summon {
	data modify storage spiced:mantis_npc conversation_order set value []
	data modify storage spiced:mantis_npc conversations set value [1,2,3,4,5,6]

	set #spiced.mantis_npc.chatting spiced.dummy 0
	set #spiced.mantis_npc.mining_timer spiced.dummy 0

	summon mannequin 227 73.9 183 {Rotation:[90f, 0f], Tags:['summit.booth_entity.spiced', 'spiced.mantis_npc'],Invulnerable:1b,immovable:true,profile:{name:'stateus'},hide_description:true,active_effects:[{id:invisibility,show_particles:false,duration:-1}],equipment:{head:{id:"minecraft:barrier",components:{"minecraft:item_model":"thorax:entity/bug/praying_mantis"}}}}

	summon interaction 227 75 183 { \
		Tags:['summit.booth_entity.spiced', 'summit.static', 'spiced.mantis_npc.interaction', 'summit.interactable'], \
		width:1f, height:1f, response:true, \
		data: { \
			summit_interactable: { \
				on_right_click: 'function spiced:mantis_npc/start_conversation', \
				on_left_click: 'function spiced:mantis_npc/start_conversation', \
			} \
		} \
	}
	function ./reset
}

function tick {
	execute \
		if score #spiced.mantis_npc.chatting spiced.dummy matches 1 \
		as @e[type=mannequin,tag=spiced.mantis_npc,limit=1] \
		at @s \
	run return run rotate @s facing entity @p
}

function says {
	# ARGS: {message: TextComponent}
	$execute \
		as @e[type=mannequin,tag=spiced.mantis_npc,limit=1] \
		at @s \
		positioned ~ ~2.125 ~ \
	run { {message: $(message)}
		chatter e73fcae3-5c03-41c8-aab8-496fe1719fe2 4..8 spiced:mantis_npc/sounds
	}
}

function sounds {
	execute store result storage spiced:mantis_npc args.note float 0.01 run random value 100..150
	{ with storage spiced:mantis_npc args
		$playsound spiced:booth.sr_mantis.speech player @a[tag=summit.in_booth.spiced,distance=..20] ~ ~ ~ 0.5 $(note)
	}
}

function reset {
	execute as @e[type=mannequin,tag=spiced.mantis_npc,limit=1] at @s run rotate @s 90 0
	scoreboard players set #spiced.mantis_npc.chatting spiced.dummy 0
	kill e73fcae3-5c03-41c8-aab8-496fe1719fe2

	REPEAT (0, 110) as i {
		schedule clear spiced:mantis_npc/zzz/<%i%>
	}
}

function start_conversation {
	execute if score #spiced.mantis_npc.chatting spiced.dummy matches 1 run return 0

	execute store result score #length spiced.dummy run data get storage spiced:mantis_npc conversation_order
	execute if score #length spiced.dummy matches 0 run {
		data modify storage spiced:mantis_npc conversation_order set from storage spiced:mantis_npc conversations
		# function shuffle:shuffle {source: 'storage spiced:mantis_npc conversations', target: 'storage spiced:mantis_npc conversation_order'}
	}

	set #spiced.mantis_npc.chatting spiced.dummy 1

	data modify storage spiced:temp args.conversation set from storage spiced:mantis_npc conversation_order[0]
	data remove storage spiced:mantis_npc conversation_order[0]
	{ with storage spiced:temp args
		$function spiced:mantis_npc/conversation$(conversation)
	}
}

function conversation1 {
	sequence {
		execute positioned 227 75 183 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/mantis
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'Hey', color: '#f0d8c8'}, ' there!', ' Seems', ' like', ' I', ' went', ' to', ' the', ' wrong', ' booth,', ' huh?']}

		sleep 80t
		function ./says {message:[{text:'I', color: '#f0d8c8'}, ' don\'t', ' mind', ' though,', ' it\'s', ' pretty', ' rad', ' here!']}

		sleep 80t
		function ./says {message:[{text:'There\'s', color: '#f0d8c8'}, ' so', ' much', ' food', ' and', ' no', ' pesky', ' crows', ' trying', ' to', ' eat', ' me!']}

		sleep 100t
		function ./reset
	}
}

function conversation2 {
	sequence {
		execute positioned 227 75 183 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/mantis
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'My', color: '#f0d8c8'}, ' siblings', ' are', ' probably', ' wondering', ' where', ' I', ' am,', ' I', ' was', ' supposed', ' to', ' be', ' helping...']}

		sleep 120t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' let', ' them', ' wonder!', ' Let', ' them', ' struggle', ' and', ' adapt!', ' Isn\'t', ' that', ' what', ' makes', ' life', ' worth', ' living?!?']}

		sleep 120t
		function ./says {message:[{text:'Sorry,', color: '#f0d8c8'}, ' I', ' got', ' a', ' little', ' carried', ' away', ' there...']}

		sleep 80t
		function ./reset
	}
}

function conversation3 {
	sequence {
		execute positioned 227 75 183 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/mantis
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'So', color: '#f0d8c8'}, ' many', ' people', ' coming', ' together', ' to', ' show', ' their', ' creations...', ' it\'s', ' pretty', ' inspiring', ' honestly.']}

		sleep 110t
		function ./says {message:[{text:'I', color: '#f0d8c8'}, ' think', ' John', ' was', ' worried', ' about', ' being', ' here,', ' being', ' inferior.', ' But', ' it\'s', ' not', ' about', ' that.']}

		sleep 120t
		function ./says {message:[{text:'It\'s', color: '#f0d8c8'}, ' about', ' your', ' heart.', ' Your', ' creations,', ' whatever', ' went', ' into', ' them,', ' are', ' invaluable.', ' YOU', ' are', ' invaluable.']}

		sleep 120t
		function ./reset
	}
}

function conversation4 {
	sequence {
		execute positioned 227 75 183 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/mantis
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'I', color: '#f0d8c8'}, ' used', ' to', ' crave', ' perfection.', ' I', ' would', ' tear', ' up', ' my', ' work', ' if', ' it', ' was', ' insufficient,', ' I\'d', ' compare', ' myself', ' to', ' others...']}

		sleep 140t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' at', ' the', ' same', ' time,', ' I\'d', ' envy', ' those', ' who', ' unabashedly', ' share', ' their', ' work,', ' especially', ' those', ' I', ' deemed', ' less', ' skilled', ' than', ' I...']}

		sleep 160t
		function ./says {message:[{text:'But', color: '#f0d8c8'}, ' now,', ' I\'m', ' glad', ' to', ' be', ' able', ' to', ' share', ' my', ' creations', ' and', ' share', ' the', ' spotlight', ' with', ' so', ' many', ' people.']}

		sleep 140t
		function ./reset
	}
}

function conversation5 {
	sequence {
		execute positioned 227 75 183 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/mantis
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'A', color: '#f0d8c8'}, ' shame', ' we', ' only', ' have', ' two', ' weeks', ' left', ' together...', ' maybe', ' only', ' a', ' few', ' hours', ' depending', ' on', ' when', ' you\'ve', ' found', ' me...']}

		sleep 140t
		function ./says {message:[{text:'And', color: '#f0d8c8'}, ' when', ' it\'s', ' all', ' over,', ' you\'ll', ' probably', ' forget', ' this', ' happened', ' at', ' all.']}

		sleep 120t
		function ./says {message:[{text:'This', color: '#f0d8c8'}, ' server', ' will', ' close,', ' your', ' memory', ' will', ' slowly', ' fade,', ' and', ' all', ' these', ' little', ' moments', ' will', ' disappear...']}

		sleep 155t
		function ./says {message:[{text:'Yet', color: '#f0d8c8'}, ' how', ' you', ' felt,', ' how', ' you', ' were', ' inspired...', ' those,', ' little', ' sparks', ' will', ' persist.']}

		sleep 100t
		function ./says {message:[{text:'Maybe', color: '#f0d8c8'}, ' you\'ll', ' make', ' something,', ' too?', ' If', ' you', ' haven\'t', ' already.']}

		sleep 80t
		function ./reset
	}
}

function conversation6 {
	sequence {
		execute positioned 227 75 183 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/mantis
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'Thanks', color: '#f0d8c8'}, ' for', ' listening', ' to', ' my', ' ramblings,', ' I', ' hope', ' you', ' enjoy', ' the', ' rest', ' of', ' the', ' Summit,', ' however', ' much', ' time', ' that', ' is.']}

		sleep 140t
		function ./says {message:[{text:'Hey,', color: '#f0d8c8'}, ' could', ' you', ' do', ' me', ' a', ' little', ' favor', ' and', ' take', ' this', ' photo', ' to', ' my', ' brother,', ' John?']}

		sleep 120t
		function ./says {message:[{text:'He\'s', color: '#f0d8c8'}, ' at', ' the', ' Thorax', ' booth.', ' I\'m', ' sure', ' he\'s', ' worried', ' about', ' me', ' by', ' now.']}

		sleep 100t
		execute positioned 227 75 183 run loot give @p[tag=summit.in_booth.spiced,distance=..12] loot thorax:items/mantis_memento
		execute positioned 227 75 183 run playsound minecraft:entity.item.pickup player @p[tag=summit.in_booth.spiced,distance=..12] ~ ~ ~ 0.5 1

		sleep 25t
		function ./reset
	}
}