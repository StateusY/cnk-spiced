import ../sequence.mcbt
import ../score.mcbt
import ../chatter.mcbt

function summon {
	data modify storage spiced:toast_npc conversation_order set value []
	data modify storage spiced:toast_npc conversations set value [1]

	set #spiced.toast_npc.chatting spiced.dummy 0
	set #spiced.toast_npc.mining_timer spiced.dummy 0
	summon mannequin 222.5 72.0 202.9 {Rotation:[75f, 0f], Tags:['summit.booth_entity.spiced', 'spiced.toast_npc'],Invulnerable:1b,immovable:true,profile:{name:'toastoneandonly'},hide_description:true}
	# execute positioned 189 53 181 run swing @e[type=mannequin,distance=..1,limit=1]
	setblock 222 72 203 air
	setblock 222 72 202 air

	summon interaction 222.5 72.0 202.9 { \
		Tags:['summit.booth_entity.spiced', 'summit.static', 'spiced.toast_npc.interaction', 'summit.interactable'], \
		width:1f, height:2f, response:true, \
		data: { \
			summit_interactable: { \
				on_right_click: 'function spiced:toast_npc/start_conversation', \
				on_left_click: 'function spiced:toast_npc/start_conversation', \
			} \
		} \
	}
	function ./reset
}

function tick {
	execute \
		if score #spiced.toast_npc.chatting spiced.dummy matches 1 \
		as @e[type=mannequin,tag=spiced.toast_npc,limit=1] \
		at @s \
	run return run rotate @s facing entity @p
}

function says {
	# ARGS: {message: TextComponent}
	$execute \
		as @e[type=mannequin,tag=spiced.toast_npc,limit=1] \
		at @s \
		positioned ~ ~2.125 ~ \
	run { {message: $(message)}
		chatter 71c8e33d-aec2-4813-af0a-1608bef4fd27 4..8 spiced:toast_npc/sounds
	}
}

function sounds {
	execute store result storage spiced:toast_npc args.note float 0.01 run random value 80..125
	{ with storage spiced:toast_npc args
		$playsound minecraft:entity.zombie.destroy_egg player @a[tag=summit.in_booth.spiced,distance=..20] ~ ~ ~ 0.5 $(note)
	}
}

function reset {
	execute as @e[type=mannequin,tag=spiced.toast_npc,limit=1] at @s run rotate @s 75 0
	scoreboard players set #spiced.toast_npc.chatting spiced.dummy 0
	kill 71c8e33d-aec2-4813-af0a-1608bef4fd27

	REPEAT (0, 110) as i {
		schedule clear spiced:toast_npc/zzz/<%i%>
	}
}

function start_conversation {
	execute if score #spiced.toast_npc.chatting spiced.dummy matches 1 run return 0

	execute store result score #length spiced.dummy run data get storage spiced:toast_npc conversation_order
	execute if score #length spiced.dummy matches 0 run {
		function shuffle:shuffle {source: 'storage spiced:toast_npc conversations', target: 'storage spiced:toast_npc conversation_order'}
	}

	set #spiced.toast_npc.chatting spiced.dummy 1

	data modify storage spiced:temp args.conversation set from storage spiced:toast_npc conversation_order[0]
	data remove storage spiced:toast_npc conversation_order[0]
	{ with storage spiced:temp args
		$function spiced:toast_npc/conversation$(conversation)
	}
}

function conversation1 {
	sequence {
		execute positioned 223 72 203 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/toast
		execute positioned 223 72 203 as @p[tag=summit.in_booth.spiced,distance=..12,limit=4] run function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'Oh,', color: '#669fb2'}, ' don\'t', ' mind', ' me.']}

		sleep 48t
		function ./says {message:[{text:'I\'m', color: '#669fb2'}, ' here', ' just', ' enjoying', ' the', ' view.']}

		sleep 56t
		function ./says {message:[{text:'Alright,', color: '#669fb2'}, ' I\'ll', ' be', ' honest', ' with', ' you.']}

		sleep 55t
		function ./says {message:[{text:'I', color: '#669fb2'}, ' was', ' parkouring', ' and', ' now', ' I\'m', ' stuck', ' here.']}

		sleep 66t
		function ./says {message:[{text:'I', color: '#669fb2'}, ' have', ' a', ' terrible', ' fear', ' of', ' heights.']}

		sleep 54t
		function ./says {message:[{text:'Made', color: '#669fb2'}, ' making', ' my', ' booth', ' really', ' hard.']}

		sleep 57t
		function ./says {message:[{text:'Go', color: '#669fb2'}, ' check', ' it', ' out,', ' it\'s', ' over', ' on', ' that', ' terribly', ' large', ' hill!']}

		sleep 84t
		function ./reset
	}
}
