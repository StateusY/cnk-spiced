import ../sequence.mcbt
import ../score.mcbt
import ../chatter.mcbt

function summon {
	data modify storage spiced:c4t_npc conversation_order set value []
	data modify storage spiced:c4t_npc conversations set value [1,2,3,4]

	set #spiced.c4t_npc.chatting spiced.dummy 0
	set #spiced.c4t_npc.mining_timer spiced.dummy 0
	summon item_display 215 86.5 189 {item_display:"ground",Tags:["summit.booth_entity.spiced", 'spiced.c4t_npc'],transformation:{left_rotation: [0.0f, -0.6156615f, 0.0f, 0.78801084f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1.0f,1.0f,1.0f]},item:{id:"minecraft:barrier",components:{"minecraft:item_model":"spiced:c4t"}}}

	summon mannequin 215 85 189 {Rotation:[180f, 0f], Tags:['summit.booth_entity.spiced', 'spiced.c4t_npc'],Invulnerable:1b,immovable:true,profile:{name:'stateus'},hide_description:true,active_effects:[{id:invisibility,show_particles:false,duration:-1}]}

	summon interaction 215 86 189 { \
		Tags:['summit.booth_entity.spiced', 'summit.static', 'spiced.c4t_npc.interaction', 'summit.interactable'], \
		width:1f, height:1f, response:true, \
		data: { \
			summit_interactable: { \
				on_right_click: 'function spiced:c4t_npc/start_conversation', \
				on_left_click: 'function spiced:c4t_npc/start_conversation', \
			} \
		} \
	}
	function ./reset
}

function tick {
	execute \
		if score #spiced.c4t_npc.chatting spiced.dummy matches 1 \
		as @e[type=mannequin,tag=spiced.c4t_npc,limit=1] \
		at @s \
	run return run rotate @s facing entity @p
}

function says {
	# ARGS: {message: TextComponent}
	$execute \
		as @e[type=mannequin,tag=spiced.c4t_npc,limit=1] \
		at @s \
		positioned ~ ~2.125 ~ \
	run { {message: $(message)}
		chatter f4e11725-a467-4e37-bf5d-d13a1645214d 4..8 spiced:c4t_npc/sounds
	}
}

function sounds {
	execute store result storage spiced:c4t_npc args.note float 0.01 run random value 100..150
	{ with storage spiced:c4t_npc args
		$playsound minecraft:entity.cat.ambient player @a[tag=summit.in_booth.spiced,distance=..20] ~ ~ ~ 0.5 $(note)
		$playsound minecraft:block.note_block.bit player @a[tag=summit.in_booth.spiced,distance=..20] ~ ~ ~ 0.5 $(note)
		$playsound minecraft:item.lodestone_compass.lock player @a[tag=summit.in_booth.spiced,distance=..20] ~ ~ ~ 0.5 $(note)
	}
}

function reset {
	execute as @e[type=mannequin,tag=spiced.c4t_npc,limit=1] at @s run rotate @s 180 0
	scoreboard players set #spiced.c4t_npc.chatting spiced.dummy 0
	kill f4e11725-a467-4e37-bf5d-d13a1645214d

	REPEAT (0, 110) as i {
		schedule clear spiced:c4t_npc/zzz/<%i%>
	}
}

function start_conversation {
	execute on target if items entity @s weapon.mainhand poisonous_potato[minecraft:custom_data~{"spiced": {"ingredient":{"type":"cinna_shake"}}}] run return run function spiced:c4t_npc/cinna_shake
	execute if score #spiced.c4t_npc.chatting spiced.dummy matches 1 run return 0

	execute store result score #length spiced.dummy run data get storage spiced:c4t_npc conversation_order
	execute if score #length spiced.dummy matches 0 run {
		function shuffle:shuffle {source: 'storage spiced:c4t_npc conversations', target: 'storage spiced:c4t_npc conversation_order'}
	}

	set #spiced.c4t_npc.chatting spiced.dummy 1

	data modify storage spiced:temp args.conversation set from storage spiced:c4t_npc conversation_order[0]
	data remove storage spiced:c4t_npc conversation_order[0]
	{ with storage spiced:temp args
		$function spiced:c4t_npc/conversation$(conversation)
	}
}

function cinna_shake {
	item modify entity @s weapon.mainhand spiced:remove_one
	sequence {
		execute positioned 215 85 189 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/c4t
		function ./says {message:[{text:'A', color: 'gold'}, ' cinna', ' shake!!!']}

		sleep 40t
		function ./says {message:[{text:'4', color: 'gold'}, ' me??']}

		sleep 20t
		function ./says {message:[{text:'ty', color: 'gold'}, ' ty', ' ty', ' ty', ' ty', ' ty', ' ty!!!']}

		sleep 80t
		function ./says {message:[{text:'I', color: 'gold'}, ' loves', ' loves', ' u', ' much', ' much!!!']}

		sleep 80t
		execute positioned 200 64 207 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only summit.sticker_book:spiced/cinna_shake
		function ./reset
	}
}

function conversation1 {
	sequence {
		execute positioned 215 85 189 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/c4t
		function ./says {message:[{text:'Yes,', color: 'gold'}, ' I\'m', ' a', ' cat.']}

		sleep 40t
		function ./says {message:[{text:'But', color: 'gold'}, ' I', ' also', ' am', ' a', ' robot.']}

		sleep 80t
		function ./says {message:[{text:'I\'m', color: 'gold'}, ' C4T', ' the', ' Computer', ' Controlled', ' Cat-like', ' Creature', ' Technology!']}

		sleep 80t
		function ./says {message:[{text:'Genius', color: 'gold'}, ' acronym', ' right?']}

		sleep 40t
		function ./says {message:[{text:'My', color: 'gold'}, ' creators', ' thought', ' so.']}

		sleep 40t
		function ./reset
	}
}

function conversation2 {
	sequence {
		execute positioned 215 85 189 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/c4t
		function ./says {message:[{text:'I', color: 'gold'}, ' am', ' planned', ' for', ' Spiced.']}

		sleep 80t
		function ./says {message:[{text:'But', color: 'gold'}, ' not', ' 1.0']}

		sleep 40t
		function ./says {message:[{text:'Stateus', color: 'gold'}, ' and', ' Pan', ' have', ' way', ' too', ' much', ' to', ' do.']}

		sleep 80t
		function ./says {message:[{text:'I', color: 'gold'}, ' hope', ' I', ' can', ' be', ' implemented', ' in', ' Spiced\'s', ' first', ' update', ' after', ' release.']}

		sleep 100t
		function ./says {message:[{text:'I', color: 'gold'}, ' know', ' there', ' isn\'t', ' space', ' for', ' me', ' in', ' release.']}

		sleep 80t
		function ./says {message:[{text:'But', color: 'gold'}, ' I', ' know', ' I', ' will', ' see', ' you', ' soon!']}

		sleep 80t
		function ./reset
	}
}

