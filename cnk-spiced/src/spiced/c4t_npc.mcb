	sequence {
		execute positioned 215 85 189 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/c4t
		function ./says {message:[{text:'If', color: 'gold'}, ' only', ' I', ' could', ' move...']}

		sleep 80t
		function ./says {message:[{text:'But', color: 'gold'}, ' I', ' lack', ' animations', ' at', ' the', ' moment.']}

		sleep 80t
		function ./says {message:[{text:'Someday...', color: 'gold'}]}

		sleep 30t
		function ./reset
	}
}

function conversation4 {
	sequence {
		execute positioned 215 85 189 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/c4t
		function ./says {message:[{text:'Have', color: 'gold'}, ' you', ' found', ' Cinnamon', ' yet?']}

		sleep 60t
		function ./says {message:[{text:'I', color: 'gold'}, ' loves', ' cinnamon!']}

		sleep 40t
		function ./says {message:[{text:'I', color: 'gold'}, ' mix', ' it', ' with', ' eggnog,', ' it\'s', ' sooooo', ' yums!!']}

		sleep 80t
		function ./says {message:[{text:'Try', color: 'gold'}, ' mixin\'', ' up', ' eggnog', ' in', ' a', ' bowl!']}

		sleep 80t
		function ./says {message:[{text:'It\'s', color: 'gold'}, ' supa', ' easy!', ' Just', ' use', ' an', ' egg,', ' milk,', ' and', ' some', ' sugar!']}

		sleep 100t
		function ./reset
	}
}