import ../sequence.mcbt
import ../score.mcbt
import ../chatter.mcbt

function summon {
	data modify storage spiced:scrappy_npc conversation_order set value []
	data modify storage spiced:scrappy_npc conversations set value [1,2,3,4]

	set #spiced.scrappy_npc.chatting spiced.dummy 0
	set #spiced.scrappy_npc.mining_timer spiced.dummy 0
	summon mannequin 228 80.5 176 {Rotation:[-125f, 0f], Tags:['summit.booth_entity.spiced', 'spiced.scrappy_npc'],Invulnerable:1b,immovable:true,profile:{name:'itzscraqpy'},hide_description:true}
	execute positioned 228 80.5 176 run swing @e[type=mannequin,tag=spiced.scrappy_npc, limit=1,distance=..1]

	summon interaction 228 80.5 176 { \
		Tags:['summit.booth_entity.spiced', 'summit.static', 'spiced.scrappy_npc.interaction', 'summit.interactable'], \
		width:1f, height:2f, response:true, \
		data: { \
			summit_interactable: { \
				on_right_click: 'function spiced:scrappy_npc/start_conversation', \
				on_left_click: 'function spiced:scrappy_npc/start_conversation', \
			} \
		} \
	}
	function ./reset
}

function tick {
	execute \
		if score #spiced.scrappy_npc.chatting spiced.dummy matches 1 \
		as @e[type=mannequin,tag=spiced.scrappy_npc,limit=1] \
		at @s \
	run return run rotate @s facing entity @p
}

function says {
	# ARGS: {message: TextComponent}
	$execute \
		as @e[type=mannequin,tag=spiced.scrappy_npc,limit=1] \
		at @s \
		positioned ~ ~2.125 ~ \
	run { {message: $(message)}
		chatter 77846f35-35d8-477f-9a07-7aba648bb730 4..8 spiced:scrappy_npc/sounds
	}
}

function sounds {
	execute store result storage spiced:scrappy_npc args.note float 0.01 run random value 150..175
	{ with storage spiced:scrappy_npc args
		$playsound minecraft:entity.rabbit.hurt player @a[tag=summit.in_booth.spiced,distance=..20] ~ ~ ~ 1 $(note)
	}
}

function reset {
	execute as @e[type=mannequin,tag=spiced.scrappy_npc,limit=1] at @s run rotate @s -125 0
	scoreboard players set #spiced.scrappy_npc.chatting spiced.dummy 0
	kill 77846f35-35d8-477f-9a07-7aba648bb730

	REPEAT (0, 110) as i {
		schedule clear spiced:scrappy_npc/zzz/<%i%>
	}
}

function start_conversation {
	execute if score #spiced.scrappy_npc.chatting spiced.dummy matches 1 run return 0

	execute store result score #length spiced.dummy run data get storage spiced:scrappy_npc conversation_order
	execute if score #length spiced.dummy matches 0 run {
		function shuffle:shuffle {source: 'storage spiced:scrappy_npc conversations', target: 'storage spiced:scrappy_npc conversation_order'}
	}

	set #spiced.scrappy_npc.chatting spiced.dummy 1

	data modify storage spiced:temp args.conversation set from storage spiced:scrappy_npc conversation_order[0]
	data remove storage spiced:scrappy_npc conversation_order[0]
	{ with storage spiced:temp args
		$function spiced:scrappy_npc/conversation$(conversation)
	}
}

function conversation1 {
	sequence {
		execute positioned 228 80 176 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/scrappy
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'The', color: '#ebe296'}, ' sea', ' washes', ' upon', ' these', ' digital', ' shores', ' over', ' and', ' over.']}

		sleep 127t
		function ./says {message:[{text:'It', color: '#ebe296'}, ' reminds', ' me', ' of', ' one', ' thing.']}

		sleep 82t
		function ./says {message:[{text:'Lettuce.', color: '#ebe296'}]}

		sleep 31t
		function ./says {message:[{text:'Without', color: '#ebe296'}, ' lettuce,', ' salads', ' would', ' be', ' lacking.']}

		sleep 82t
		function ./says {message:[{text:'Without', color: '#ebe296'}, ' lettuce,', ' lambs', ' would', ' go', ' hungry.']}

		sleep 80t
		function ./says {message:[{text:'Without', color: '#ebe296'}, ' lettuce,', ' I', ' would', ' simply', ' be', ' unable', ' to', ' achieve', ' my', ' life', ' long', ' goal', ' of', ' attaining', ' a', ' reasonable', ' amount', ' of', ' lettuce.']}

		sleep 224t
		function ./reset
	}
}

function conversation2 {
	sequence {
		execute positioned 228 80 176 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/scrappy
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'Here,', color: '#ebe296'}, ' I', ' can', ' do', ' the', ' impossible.']}

		sleep 84t
		function ./says {message:[{text:'I', color: '#ebe296'}, ' can', ' create', ' an', ' unreasonable', ' amount', ' of', ' lettuce.']}

		sleep 105t
		function ./says {message:[{text:'Yes,', color: '#ebe296'}, ' it', ' is', ' risky,', ' but', ' it', ' is', ' rewarding.']}

		sleep 102t
		function ./says {message:[{text:'It', color: '#ebe296'}, ' is', ' the', ' step', ' beyond,', ' a', ' compression', ' one', ' more', ' than', ' the', ' last.']}

		sleep 143t
		function ./reset
	}
}

function conversation3 {
	sequence {
		execute positioned 228 80 176 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/scrappy
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'Lettuce', color: '#ebe296'}, ' lettuce', ' lettuce', ' lettuce']}

		sleep 64t
		function ./reset
	}
}

function conversation4 {
	sequence {
		execute positioned 228 80 176 run advancement grant @p[tag=summit.in_booth.spiced,distance=..12,limit=4] only spiced:npcs/scrappy
		function spiced:extras/npc_sticker_check
		function ./says {message:[{text:'Yum', color: '#ebe296'}, ' yum', ' yum', ' yum', ' UNREASONABLE', ' yum', ' yum', ' yum', ' yum', ' yum...']}

		sleep 127t
		function ./reset
	}
}