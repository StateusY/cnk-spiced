#> spiced.iris:setup/scoreboard
#
# Sets up the scoreboard (objectives and scores) for Iris
#
# @within spiced.iris:setup/load

scoreboard objectives add spiced.iris dummy {"text": "spiced Iris", "color": "gold"}
scoreboard objectives add spiced.iris.id dummy {"text": "spiced Iris entity IDs", "color": "gold"}

scoreboard players set $-1 spiced.iris -1
scoreboard players set $2 spiced.iris 2
scoreboard players set $11 spiced.iris 11
scoreboard players set $16 spiced.iris 16
scoreboard players set $256 spiced.iris 256
scoreboard players set $1000 spiced.iris 1000
scoreboard players set $33333 spiced.iris 33333
scoreboard players set $65536 spiced.iris 65536
scoreboard players set $1000000 spiced.iris 1000000
