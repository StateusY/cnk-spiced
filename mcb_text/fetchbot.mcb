		function ./says {message:[{text:"You", color: aqua}, ' know', ' what', ' to', ' do.']}

		sleep 80t
		function ./reset
	}
}

function conversation6 {
	sequence {
		function ./says {message:[{text:"The", color: aqua}, ' job', ' market', ' is', ' tough.']}

		sleep 60t
		function ./says {message:[{text:"We're", color: aqua}, ' giving', ' you', ' a', ' leg', ' up.']}

		sleep 80t
		function ./reset
	}
}
